---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import artwork from '../../assets/artworks/figures-in-an-interior.jpg';
---

<BaseLayout
  title="Figures in an Interior"
  description="Figures in an Interior, a 2026 painting by Alexander Sumer."
  image={artwork.src}
>
  <article class="artwork">
    <header class="artwork__header">
      <a class="artwork__back" href="/art/">← Art</a>
      <h1>Figures in an Interior</h1>
      <p>2026</p>
    </header>

    <a href={artwork.src} aria-label="Open the full-size artwork">
      <Image
        src={artwork}
        alt="A figurative painting of people gathered in a richly coloured interior"
        class="artwork__image"
        widths={[700, 1400, 2100]}
        sizes="(max-width: 748px) calc(100vw - 48px), 700px"
        loading="eager"
      />
    </a>
    <p class="artwork__note">
      Inspired by <a
        href="https://www.artsy.net/artwork/kees-van-dongen-amusement"
        target="_blank"
        rel="noopener">Kees van Dongen’s <cite>Amusement</cite> (1914)</a
      >.
    </p>
  </article>
</BaseLayout>
