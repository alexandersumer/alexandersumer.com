<script is:inline>
  (function () {
    var s;
    try {
      s = localStorage.getItem('theme');
    } catch {
      // Storage can be unavailable; the system preference still works.
    }
    var saved = s === 'dark' || s === 'light';
    var t = saved
      ? s
      : window.matchMedia('(prefers-color-scheme: dark)').matches
        ? 'dark'
        : 'light';
    document.documentElement.setAttribute('data-theme', t);
    document.documentElement.setAttribute('data-theme-preference', saved ? 'manual' : 'system');
  })();
</script>
